    "REQUEST_DELAY": 3.0,
    "MAX_RETRIES": 3,
    "TIMEOUT": 60,
    "STREAM_TIMEOUT": 90,

    "_提取模式": "=== PDF 提取模式: 'vision' | 'text' | 'hybrid' ===",
