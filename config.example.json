    "VECTOR_STORE_BACKEND": "chromadb",
    "CHROMADB_PERSIST_DIR": "dialogue data/vector_store",

    "_页面预筛选": "=== RAG1: 页面预筛选参数 ===",
    "PAGE_FILTER_ENABLED": true,
    "PAGE_FILTER_THRESHOLD": 0.25,
    "PAGE_FILTER_TOP_K": 4000,

    "_FewShot配置": "=== RAG2: 历史示例检索参数 ===",
    "FEW_SHOT_ENABLED": true,
    "FEW_SHOT_TOP_K": 3,

    "_语义搜索": "=== RAG3: 语义搜索（未实现）===",
