{
  "experiment_name": "钙钛矿太阳能电池薄膜制备与光谱性能表征实验",
  "created_at": "2026-04-20T14:20:30.896Z",
  "steps": [
    {
      "type": "tool",
      "name": "set_temperature",
      "params": {
        "temperature": 85
      },
      "description": "设置加热台温度为85℃，预热基板"
    },
    {
      "type": "helper",
      "name": "WAIT",
      "params": {
        "duration": 30000
      },
      "description": "等待30秒，确保温度稳定"
    },
    {
      "type": "tool",
      "name": "spin_coating",
      "params": {
        "reagent": "PbI2 precursor solution",
        "spin_acc": 2000,
        "spin_dur": 3000,
        "spin_speed": 4000,
        "volume": 50
      },
      "description": "在基板上旋涂PbI2前驱体溶液，转速4000rpm，时长3秒"
    },
    {
      "type": "helper",
      "name": "WAIT",
      "params": {
        "duration": 10000
      },
      "description": "等待10秒，让溶剂挥发"
    },
    {
      "type": "tool",
      "name": "spin_coating",
      "params": {
        "reagent": "MAI precursor solution",
        "spin_acc": 2500,
        "spin_dur": 3000,
        "spin_speed": 5000,
        "volume": 40
      },
      "description": "在PbI2薄膜上旋涂MAI前驱体溶液，转速5000rpm，时长3秒"
    },
    {
      "type": "helper",
      "name": "WAIT",
      "params": {
        "duration": 5000
      },
      "description": "等待5秒，完成薄膜形成"
    },
    {
      "type": "tool",
      "name": "set_temperature",
      "params": {
        "temperature": 100
      },
      "description": "将基板加热至100℃，进行退火处理"
    },
    {
      "type": "helper",
      "name": "WAIT",
      "params": {
        "duration": 60000
      },
      "description": "等待60秒，完成退火过程"
    },
    {
      "type": "tool",
      "name": "collect_spectrum",
      "params": {
        "duration": 10
      },
      "description": "采集薄膜的吸收光谱，采集时长10秒"
    },
    {
      "type": "software",
      "name": "spectrum_analysis",
      "params": {
        "integration_range": [
          300,
          800
        ],
        "subtract_baseline": true
      },
      "description": "对采集的光谱数据进行分析，计算最高峰波长、半高宽和峰面积",
      "input_file": "data/spectrum_data.csv",
      "output_file": "results/spectrum_analysis.json"
    },
    {
      "type": "software",
      "name": "data_statistics",
      "params": {
        "columns": [
          "peak_wavelength",
          "fwhm",
          "peak_area"
        ],
        "include_correlation": true
      },
      "description": "对光谱分析结果进行统计分析，包括均值、标准差和相关性",
      "input_file": "results/spectrum_analysis.json",
      "output_file": "results/data_stats.json"
    },
    {
      "type": "software",
      "name": "bayesian_optimization",
      "params": {
        "bounds": [
          [
            3000,
            6000
          ],
          [
            2000,
            3000
          ],
          [
            2000,
            4000
          ],
          [
            50,
            100
          ]
        ],
        "n_samples": 10
      },
      "description": "使用贝叶斯优化算法预测下一轮最优的旋涂参数组合",
      "input_file": "results/data_stats.json",
      "output_file": "results/optimized_params.json"
    },
    {
      "type": "helper",
      "name": "USER_INPUT",
      "params": {
        "prompt": "是否继续执行下一轮优化实验？",
        "var_name": "continue_experiment"
      },
      "description": "询问用户是否继续执行下一轮实验"
    },
    {
      "type": "condition",
      "name": "CONDITION",
      "params": {
        "condition": "continue_experiment == 'yes'"
      },
      "description": "如果用户选择继续，则执行下一轮实验"
    },
    {
      "type": "helper",
      "name": "LOOP",
      "params": {
        "count": 3
      },
      "description": "循环执行3次优化实验"
    },
    {
      "type": "tool",
      "name": "start_experiment",
      "params": {},
      "description": "启动已注册的实验序列"
    },
    {
      "type": "helper",
      "name": "END",
      "params": {},
      "description": "结束循环"
    },
    {
      "type": "helper",
      "name": "END",
      "params": {},
      "description": "结束条件"
    }
  ]
}