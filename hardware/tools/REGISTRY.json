{
  "spin_coating": {
    "name": "spin_coating",
    "description": "旋涂实验 - 在基板上旋涂试剂溶液",
    "params": {
      "spin_speed": {
        "type": "int",
        "description": "旋涂转速(rpm)",
        "required": true,
        "default": 3000
      },
      "spin_acc": {
        "type": "int",
        "description": "旋涂加速度(rpm/s)",
        "required": true,
        "default": 1000
      },
      "spin_dur": {
        "type": "int",
        "description": "旋涂时长(ms)",
        "required": true,
        "default": 30000
      },
      "reagent": {
        "type": "str",
        "description": "试剂名称",
        "required": true
      },
      "volume": {
        "type": "float",
        "description": "试剂体积(μL)",
        "required": true,
        "default": 10.0
      }
    }
  },
  "set_temperature": {
    "name": "set_temperature",
    "description": "温度控制 - 设置加热台温度",
    "params": {
      "temperature": {
        "type": "float",
        "description": "目标温度(℃)",
        "required": true
      }
    }
  },
  "move_robot_arm": {
    "name": "move_robot_arm",
    "description": "机械臂移动 - 移动机械臂到指定坐标",
    "params": {
      "x": {
        "type": "float",
        "description": "X坐标(mm)",
        "required": true
      },
      "y": {
        "type": "float",
        "description": "Y坐标(mm)",
        "required": true
      },
      "z": {
        "type": "float",
        "description": "Z坐标(mm)",
        "required": true
      }
    }
  },
  "collect_spectrum": {
    "name": "collect_spectrum",
    "description": "光谱采集 - 启动光谱仪采集数据",
    "params": {
      "duration": {
        "type": "int",
        "description": "采集时长(秒)",
        "required": true,
        "default": 10
      }
    }
  },
  "start_experiment": {
    "name": "start_experiment",
    "description": "启动实验 - 启动已注册的实验序列",
    "params": {}
  }
}
