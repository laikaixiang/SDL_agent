{
  "spin_coating": {
    "name": "spin_coating",
    "description": "执行旋涂实验，向平台发送旋涂参数",
    "params": {
      "spin_speed": {
        "type": "int",
        "description": "转速(rpm)",
        "required": true
      },
      "spin_acc": {
        "type": "int",
        "description": "加速度(rpm/s)",
        "required": true
      },
      "spin_dur": {
        "type": "int",
        "description": "持续时间(ms)",
        "required": true
      },
      "reagent": {
        "type": "str",
        "description": "试剂名称",
        "required": true
      },
      "volume": {
        "type": "int",
        "description": "体积(µl)",
        "required": true
      }
    }
  },
  "set_temperature": {
    "name": "set_temperature",
    "description": "设置加热台温度",
    "params": {
      "target": {
        "type": "float",
        "description": "目标温度(℃)",
        "required": true
      }
    }
  },
  "move_robot_arm": {
    "name": "move_robot_arm",
    "description": "移动机械臂到指定坐标",
    "params": {
      "x": {
        "type": "float",
        "description": "X坐标",
        "required": true
      },
      "y": {
        "type": "float",
        "description": "Y坐标",
        "required": true
      },
      "z": {
        "type": "float",
        "description": "Z坐标",
        "required": true
      }
    }
  },
  "start_experiment": {
    "name": "start_experiment",
    "description": "启动已注册的实验序列",
    "params": {}
  },
  "collect_spectrum": {
    "name": "collect_spectrum",
    "description": "启动光谱仪数据采集",
    "params": {
      "duration": {
        "type": "int",
        "description": "采集时长(秒)",
        "required": false,
        "default": 60
      }
    }
  }
}